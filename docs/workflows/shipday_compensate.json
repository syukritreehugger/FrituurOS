{
 "name": "shipday_compensate",
 "nodes": [
  {
   "id": "trigger-schedule",
   "name": "Schedule (60s)",
   "type": "n8n-nodes-base.scheduleTrigger",
   "typeVersion": 1.2,
   "position": [
    0,
    100
   ],
   "parameters": {
    "rule": {
     "interval": [
      {
       "field": "seconds",
       "secondsInterval": 60
      }
     ]
    }
   }
  },
  {
   "id": "trigger-manual",
   "name": "Manual Trigger",
   "type": "n8n-nodes-base.manualTrigger",
   "typeVersion": 1,
   "position": [
    0,
    300
   ],
   "parameters": {}
  },
  {
   "id": "pgmq-read",
   "name": "Read q_orders_compensate",
   "type": "n8n-nodes-base.postgres",
   "typeVersion": 2.5,
   "position": [
    250,
    200
   ],
   "parameters": {
    "operation": "executeQuery",
    "query": "SELECT msg_id, message FROM pgmq_read_order('q_orders_compensate', 120, 5);",
    "options": {}
   },
   "credentials": {
    "postgres": {
     "id": "9zc3jzWzgtSSJL0O",
     "name": "Postgres Data Catalog"
    }
   }
  },
  {
   "id": "parse-msg",
   "name": "Parse Messages",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    500,
    200
   ],
   "parameters": {
    "jsCode": "const items = $input.all();\nif (!items.length || !items[0].json.msg_id) return [];\nreturn items.map(i => {\n  const msg = typeof i.json.message === 'string' ? JSON.parse(i.json.message) : i.json.message;\n  return { json: { ...i.json, ...msg } };\n});"
   }
  },
  {
   "id": "load-key",
   "name": "Load Shipday Key",
   "type": "n8n-nodes-base.postgres",
   "typeVersion": 2.5,
   "position": [
    750,
    200
   ],
   "parameters": {
    "operation": "executeQuery",
    "query": "=SELECT COALESCE((SELECT decrypted_secret FROM vault.decrypted_secrets WHERE name = 'shipday_api_key_' || '{{ $json.location_key }}' LIMIT 1), '') AS shipday_api_key;",
    "options": {}
   },
   "credentials": {
    "postgres": {
     "id": "9zc3jzWzgtSSJL0O",
     "name": "Postgres Data Catalog"
    }
   }
  },
  {
   "id": "delete-shipday",
   "name": "DELETE Shipday Order",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    1000,
    200
   ],
   "parameters": {
    "method": "DELETE",
    "url": "=https://api.shipday.com/orders/{{ $('Parse Messages').item.json.shipday_order_id }}",
    "sendHeaders": true,
    "specifyHeaders": "keypair",
    "headerParameters": {
     "parameters": [
      {
       "name": "Authorization",
       "value": "=Basic {{ $json.shipday_api_key }}"
      },
      {
       "name": "Accept",
       "value": "application/json"
      }
     ]
    },
    "options": {
     "timeout": 15000,
     "response": {
      "response": {
       "fullResponse": true,
       "responseFormat": "text",
       "neverError": true
      }
     }
    }
   }
  },
  {
   "id": "classify",
   "name": "Classify Result",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1250,
    200
   ],
   "parameters": {
    "jsCode": "// 204 = cancelled; 400/404 = order already gone or too old to cancel \u2014 both terminal.\n// 401/5xx = leave message; visibility timeout re-delivers it next cycle.\nconst parsed = $('Parse Messages').all();\nreturn $input.all().map((it, idx) => {\n  const code = it.json.statusCode || 0;\n  const handled = code === 204 || code === 400 || code === 404;\n  const p = parsed[idx].json;\n  return { json: { handled, statusCode: code, msg_id: p.msg_id, shipday_order_id: p.shipday_order_id, canonical_order_id: p.canonical_order_id, external_ref: p.external_ref, location_key: p.location_key } };\n});"
   }
  },
  {
   "id": "if-handled",
   "name": "IF Handled",
   "type": "n8n-nodes-base.if",
   "typeVersion": 2.2,
   "position": [
    1500,
    200
   ],
   "parameters": {
    "conditions": {
     "options": {
      "caseSensitive": true,
      "leftValue": "",
      "typeValidation": "strict",
      "version": 2
     },
     "conditions": [
      {
       "id": "handled-cond",
       "leftValue": "={{ $json.handled }}",
       "rightValue": true,
       "operator": {
        "type": "boolean",
        "operation": "true",
        "singleValue": true
       }
      }
     ],
     "combinator": "and"
    }
   }
  },
  {
   "id": "finalize",
   "name": "Finalize: compensated + ack",
   "type": "n8n-nodes-base.postgres",
   "typeVersion": 2.5,
   "position": [
    1750,
    100
   ],
   "parameters": {
    "operation": "executeQuery",
    "query": "=UPDATE canonical_orders SET shipday_compensated_at = now() WHERE id = '{{ $json.canonical_order_id }}'::uuid;\nINSERT INTO dlq_alerts (queue_name, msg_id, external_ref, source, location_key, canonical_order_id, last_error, attempt_count, alerted_at, created_at, resolved_at, resolution_action)\nSELECT 'q_orders_compensate', {{ $json.msg_id }}, co.external_ref, co.source, co.location_key, co.id,\n  jsonb_build_object('message', 'Shipday order ' || '{{ $json.shipday_order_id }}' || ' cancelled after LS failure (HTTP {{ $json.statusCode }})', 'stage', 'shipday_compensate', 'code', '{{ $json.statusCode }}'),\n  1, now(), now(), now(), 'discard'\nFROM canonical_orders co WHERE co.id = '{{ $json.canonical_order_id }}'::uuid;\nSELECT pgmq_delete_order('q_orders_compensate', {{ $json.msg_id }});",
    "options": {}
   },
   "credentials": {
    "postgres": {
     "id": "9zc3jzWzgtSSJL0O",
     "name": "Postgres Data Catalog"
    }
   }
  }
 ],
